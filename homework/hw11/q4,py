#%% Part (c): Gauss-Laguerre quadrature

from numpy.polynomial.laguerre import laggauss

# Number of quadrature nodes
n = 5

# Obtain nodes and weights
nodes, weights = laggauss(n)

x_values = [2, 4, 6, 8, 10]

print(f'{"x":<5} {"Approximation":<20} {"Reference":<20} '
      f'{"Relative Error":<18} {"Evals":<8}')

for x in x_values:

    # Gauss-Laguerre quadrature
    estimate = np.sum(weights * nodes**(x-1))

    # Reference solution
    reference = gamma(x)

    # Relative error
    relative_error = abs(estimate - reference)/reference

    print(f'{x:<5} {estimate:<20.10f} {reference:<20.10f} '
          f'{relative_error:<18.6e} {n:<8}')


