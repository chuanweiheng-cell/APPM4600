
#%% Import header
import numpy as np
from scipy.special import gamma


#%% part (a)

def gamma_trapezoidal(x, upper_limit, step_size):
    n = int(np.ceil(upper_limit / step_size))
    h = upper_limit / n

    t = np.linspace(0, upper_limit, n + 1)
    f = t**(x - 1) * np.exp(-t)

    estimate = h * (0.5*f[0] + np.sum(f[1:-1]) + 0.5*f[-1])

    return estimate, n


# Experiment 1: Effect of truncation limit

h_test = 0.002

print('Study on truncation')
for L in [20, 30, 40, 50]:
    estimate, _ = gamma_trapezoidal(10, L, h_test)
    error = abs(estimate - gamma(10)) / gamma(10)

    print(f'L = {L}, relative error = {error:.6e}')


# Experiment 2: Effect of step size

L_test = 50.0

print('\nStudy on step size')
for h in [0.1, 0.02, 0.01, 0.005, 0.002]:
    estimate, _ = gamma_trapezoidal(2, L_test, h)
    error = abs(estimate - gamma(2)) / gamma(2)

    print(f'h = {h}, relative error = {error:.6e}')


# Final comparison with scipy.special.gamma

L = 50.0
h = 0.002
x_values = [2, 4, 6, 8, 10]

print('\nFinal results')
print('x     Approximation       Reference           Relative error')

for x in x_values:
    estimate, n = gamma_trapezoidal(x, L, h)
    reference = gamma(x)

    relative_error = abs(estimate - reference) / reference

    print(f'{x:<5} {estimate:<19.10f} ' f'{reference:<19.10f} {relative_error:.6e}')

